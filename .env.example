# =======================================================
# PROJECT DRONA 2.0 / BHISHMA'S - ENVIRONMENT TEMPLATE
# =======================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' (never commit '.env' to git!)
#    Command: cp .env.example .env
# 2. Fill in your real API keys and secrets below.
# =======================================================

# Docker Hub Configuration (Used by docker-compose)
DOCKERHUB_USERNAME=your_dockerhub_username

# Security & Flask Core
SECRET_KEY=generate_a_random_32_char_secret_key_here
FLASK_ENV=production
FLASK_DEBUG=False
PORT=8000

# AI Services & API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Database Configuration
# Local SQLite: sqlite:///app.db
# PostgreSQL (Optional AWS RDS): postgresql://user:password@rds-host:5432/dbname
SQLALCHEMY_DATABASE_URI=sqlite:///app.db

# File Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# CORS Allowed Origins
# Add your EC2 public IP or domain here so the browser can make API requests
CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1,http://your-ec2-public-ip

# Frontend API URL (Optional, leave blank to use Nginx internal reverse proxy)
VITE_API_BASE_URL=
