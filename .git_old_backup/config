[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/Vallabh28-lab/KURUKSHETRA
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
[branch "prajwal's_branch"]
	remote = origin
	merge = refs/heads/prajwal's_branch
	vscode-merge-base = origin/prajwal's_branch
